{
  "schemaVersion": 1,
  "id": "monumentum",
  "version": "${version}",
  "name": "Monumentum",
  "description": "An unofficial, client-side utility mod for the Monumenta MMORPG server",
  "authors": [
    "Max Panicle"
  ],
  "contact": {
    "repo": "https://github.com/gradleuu/Monumentum"
  },
  "license": "BSD-3-Clause",
  "icon": "assets/monumentum/icon.png",
  "accessWidener": "monumentum.accesswidener",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.max.monumentum.client.MonumentumClient"
    ],
    "main": [
      "io.max.monumentum.Monumentum"
    ]
  },
  "mixins": [
    "monumentum.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=0.97.3",
    "minecraft": "${minecraft_version}"
  }
}

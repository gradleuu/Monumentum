<?xml version='1.0' encoding='UTF-8'?>
<owo-ui>
  <components>
    <flow-layout direction="vertical">
      <children>
        <flow-layout direction="horizontal" id="topbar">
          <children>
            <flow-layout direction="horizontal" id="brand-container">
              <children>
                <flow-layout direction="horizontal" id="brand-logo-slot">
                  <children>
                    <label id="brand-logo">
                      <text/>
                      <shadow>false</shadow>
                    </label>
                  </children>
                  <sizing>
                    <horizontal method="fixed">8</horizontal>
                    <vertical method="fixed">10</vertical>
                  </sizing>
                </flow-layout>
                <label id="title">
                  <text/>
                  <color>#FFE6E7E9</color>
                  <shadow>true</shadow>
                </label>
                <label id="version-label">
                  <text/>
                  <color>#FF565B64</color>
                  <shadow>true</shadow>
                </label>
              </children>
              <gap>3</gap>
              <vertical-alignment>center</vertical-alignment>
              <sizing>
                <horizontal method="content"/>
                <vertical method="fixed">22</vertical>
              </sizing>
            </flow-layout>
            <flow-layout direction="horizontal" id="topbar-actions">
              <positioning type="relative">100,50</positioning>
              <children>
                <button id="github-button">
                  <text/>
                  <tooltip-text translate="true">monumentum.config.link.github</tooltip-text>
                  <renderer>
                    <flat color="#00181B20" hovered-color="#FF22262D" disabled-color="#00181B20"/>
                  </renderer>
                  <text-shadow>true</text-shadow>
                  <sizing>
                    <horizontal method="fixed">16</horizontal>
                    <vertical method="fixed">16</vertical>
                  </sizing>
                </button>
                <button id="wiki-button">
                  <text/>
                  <tooltip-text translate="true">monumentum.config.link.wiki</tooltip-text>
                  <renderer>
                    <flat color="#00181B20" hovered-color="#FF22262D" disabled-color="#00181B20"/>
                  </renderer>
                  <text-shadow>true</text-shadow>
                  <sizing>
                    <horizontal method="fixed">16</horizontal>
                    <vertical method="fixed">16</vertical>
                  </sizing>
                </button>
              </children>
              <gap>3</gap>
              <vertical-alignment>center</vertical-alignment>
              <sizing>
                <horizontal method="content"/>
                <vertical method="fixed">22</vertical>
              </sizing>
            </flow-layout>
            <box>
              <positioning type="relative">0,100</positioning>
              <sizing>
                <horizontal method="fill">100</horizontal>
                <vertical method="fixed">1</vertical>
              </sizing>
              <color>#FF1A1D22</color>
              <fill>true</fill>
            </box>
          </children>
          <horizontal-alignment>left</horizontal-alignment>
          <vertical-alignment>center</vertical-alignment>
          <padding>
            <horizontal>2</horizontal>
            <vertical>0</vertical>
          </padding>
          <sizing>
            <horizontal method="fill">100</horizontal>
            <vertical method="fixed">20</vertical>
          </sizing>
        </flow-layout>
        <flow-layout direction="horizontal" id="main-panel">
          <children>
            <flow-layout direction="vertical" id="page-sidebar">
              <children>
                <scroll direction="vertical" id="page-sidebar-scroll">
                  <flow-layout direction="vertical" id="page-sidebar-items">
                    <children/>
                    <gap>3</gap>
                    <padding>
                      <left>2</left>
                      <right>0</right>
                      <top>0</top>
                      <bottom>6</bottom>
                    </padding>
                  </flow-layout>
                  <scrollbar-thiccness>2</scrollbar-thiccness>
                  <scrollbar-color>#FF2A2D33</scrollbar-color>
                  <surface>
                    <flat>#00000000</flat>
                  </surface>
                  <sizing>
                    <horizontal method="fill">100</horizontal>
                    <vertical method="fill">100</vertical>
                  </sizing>
                </scroll>
              </children>
              <padding>
                <horizontal>2</horizontal>
                <vertical>2</vertical>
              </padding>
              <sizing>
                <horizontal method="fill">18</horizontal>
                <vertical method="fill">100</vertical>
              </sizing>
            </flow-layout>
            <flow-layout direction="vertical" id="option-panel-container">
              <children>
                <flow-layout direction="horizontal" id="page-toolbar">
                  <children>
                    <flow-layout direction="horizontal" id="search-container">
                      <children>
                        <label id="search-icon">
                          <text/>
                          <shadow>false</shadow>
                          <sizing>
                            <horizontal method="fixed">9</horizontal>
                            <vertical method="fixed">9</vertical>
                          </sizing>
                        </label>
                        <flow-layout direction="horizontal" id="search-input-container">
                          <children>
                            <text-box id="search-field">
                              <show-background>false</show-background>
                              <max-length>128</max-length>
                              <sizing>
                                <horizontal method="fill">99</horizontal>
                                <vertical method="fixed">8</vertical>
                              </sizing>
                            </text-box>
                            <label id="search-match-indicator">
                              <margins>
                                <horizontal>4</horizontal>
                              </margins>
                              <color>#FF565B64</color>
                              <shadow>false</shadow>
                            </label>
                          </children>
                          <vertical-alignment>center</vertical-alignment>
                        </flow-layout>
                      </children>
                      <gap>5</gap>
                      <vertical-alignment>center</vertical-alignment>
                      <padding>
                        <horizontal>7</horizontal>
                      </padding>
                      <surface>
                        <flat>#FF111317</flat>
                        <outline>#FF22262D</outline>
                      </surface>
                      <sizing>
                        <horizontal method="fill">95</horizontal>
                        <vertical method="fixed">15</vertical>
                      </sizing>
                    </flow-layout>
                  </children>
                  <vertical-alignment>center</vertical-alignment>
                  <sizing>
                    <horizontal method="fill">100</horizontal>
                    <vertical method="fixed">25</vertical>
                  </sizing>
                </flow-layout>
                <scroll direction="vertical" id="option-panel-scroll">
                  <flow-layout direction="vertical" id="option-panel">
                    <children/>
                    <gap>0</gap>
                    <padding>
                      <horizontal>4</horizontal>
                      <vertical>4</vertical>
                    </padding>
                  </flow-layout>
                  <scrollbar-thiccness>3</scrollbar-thiccness>
                  <scrollbar-color>#FF2A2D33</scrollbar-color>
                  <surface>
                    <flat>#00000000</flat>
                  </surface>
                  <sizing>
                    <horizontal method="fill">100</horizontal>
                    <vertical method="fill">100</vertical>
                  </sizing>
                  <padding>
                    <all>0</all>
                  </padding>
                </scroll>
              </children>
              <gap>5</gap>
              <padding>
                <horizontal>4</horizontal>
                <vertical>0</vertical>
              </padding>
              <sizing>
                <horizontal method="fill">76</horizontal>
                <vertical method="fill">100</vertical>
              </sizing>
            </flow-layout>
          </children>
          <gap>8</gap>
          <sizing>
            <horizontal method="fill">100</horizontal>
            <vertical method="fill">78</vertical>
          </sizing>
        </flow-layout>
        <flow-layout direction="horizontal" id="footer">
          <children>
            <flow-layout direction="horizontal" id="footer-statuses">
              <children/>
              <gap>8</gap>
              <vertical-alignment>center</vertical-alignment>
              <sizing>
                <horizontal method="fill">100</horizontal>
                <vertical method="fixed">16</vertical>
              </sizing>
            </flow-layout>
            <button id="reload-button">
              <text translate="true">text.owo.config.button.reload</text>
              <renderer>
                <flat color="#FF181B20" hovered-color="#FF22262D" disabled-color="#FF121417"/>
              </renderer>
              <text-shadow>false</text-shadow>
              <sizing>
                <horizontal method="fixed">60</horizontal>
                <vertical method="fixed">20</vertical>
              </sizing>
              <margins>
                <right>3</right>
              </margins>
            </button>
            <button id="done-button">
              <text translate="true">text.owo.config.button.done</text>
              <renderer>
                <flat color="#FF2F6FE0" hovered-color="#FF4A87F5" disabled-color="#FF1C2230"/>
              </renderer>
              <text-shadow>false</text-shadow>
              <sizing>
                <horizontal method="fixed">60</horizontal>
                <vertical method="fixed">20</vertical>
              </sizing>
            </button>
            <box>
              <positioning type="relative">0,0</positioning>
              <sizing>
                <horizontal method="fill">100</horizontal>
                <vertical method="fixed">1</vertical>
              </sizing>
              <color>#FF1A1D22</color>
              <fill>true</fill>
            </box>
          </children>
          <gap>5</gap>
          <horizontal-alignment>left</horizontal-alignment>
          <vertical-alignment>center</vertical-alignment>
          <padding>
            <horizontal>2</horizontal>
            <vertical>0</vertical>
          </padding>
          <sizing>
            <horizontal method="fill">100</horizontal>
            <vertical method="fixed">22</vertical>
          </sizing>
        </flow-layout>
      </children>
      <gap>5</gap>
      <horizontal-alignment>center</horizontal-alignment>
      <vertical-alignment>center</vertical-alignment>
      <surface>
        <flat>#FF0B0C0E</flat>
      </surface>
      <padding>
        <horizontal>8</horizontal>
        <vertical>5</vertical>
      </padding>
      <sizing>
        <horizontal method="fill">100</horizontal>
        <vertical method="fill">100</vertical>
      </sizing>
    </flow-layout>
  </components>
  <templates>
    <section-header>
      <flow-layout direction="horizontal">
        <children>
          <box>
            <sizing>
              <vertical method="fixed">1</vertical>
              <horizontal method="fill">20</horizontal>
            </sizing>
            <color>#FF1A1D22</color>
            <fill>true</fill>
          </box>
          <label id="header">
            <color>#FF8A8F98</color>
            <shadow>false</shadow>
            <margins>
              <horizontal>5</horizontal>
            </margins>
          </label>
          <box>
            <sizing>
              <vertical method="fixed">1</vertical>
              <horizontal method="fill">100</horizontal>
            </sizing>
            <color>#FF1A1D22</color>
            <fill>true</fill>
          </box>
        </children>
        <horizontal-alignment>center</horizontal-alignment>
        <vertical-alignment>center</vertical-alignment>
        <margins>
          <top>7</top>
          <bottom>3</bottom>
        </margins>
        <sizing>
          <horizontal method="fill">100</horizontal>
          <vertical method="fixed">20</vertical>
        </sizing>
      </flow-layout>
    </section-header>
    <section-buttons>
      <flow-layout direction="vertical">
        <children>
          <label>
            <text translate="true">text.owo.config.sections</text>
            <color>#FF565B64</color>
            <shadow>false</shadow>
            <positioning type="relative">50,0</positioning>
            <margins>
              <top>15</top>
            </margins>
          </label>
        </children>
        <vertical-alignment>center</vertical-alignment>
        <horizontal-alignment>center</horizontal-alignment>
        <sizing>
          <horizontal method="fill">0</horizontal>
          <vertical method="fill">100</vertical>
        </sizing>
      </flow-layout>
    </section-buttons>
    <config-option-base>
      <flow-layout direction="horizontal">
        <children>
          <label id="option-name">
            <text translate="true">{{config-option-name}}</text>
            <color>#FFE6E7E9</color>
            <positioning type="relative">0,50</positioning>
            <shadow>false</shadow>
          </label>
          <template-child id="controls">
            <positioning type="relative">100,50</positioning>
            <vertical-alignment>center</vertical-alignment>
          </template-child>
          <box>
            <positioning type="relative">0,100</positioning>
            <sizing>
              <horizontal method="fill">100</horizontal>
              <vertical method="fixed">1</vertical>
            </sizing>
            <color>#FF1A1D22</color>
            <fill>true</fill>
          </box>
        </children>
        <sizing>
          <horizontal method="fill">100</horizontal>
          <vertical method="fixed">28</vertical>
        </sizing>
        <padding>
          <horizontal>6</horizontal>
          <vertical>0</vertical>
        </padding>
      </flow-layout>
    </config-option-base>
    <config-option>
      <template name="config-option-base">
        <child id="controls">
          <flow-layout direction="horizontal" id="controls-flow">
            <children>
              <template-child id="value-container">
                <sizing>
                  <horizontal method="fixed">120</horizontal>
                </sizing>
              </template-child>
              <button id="reset-button">
                <text>⇄</text>
                <renderer>
                  <flat color="#00000000" hovered-color="#FF22262D" disabled-color="#00000000"/>
                </renderer>
                <text-shadow>false</text-shadow>
                <margins>
                  <horizontal>5</horizontal>
                </margins>
              </button>
            </children>
          </flow-layout>
        </child>
      </template>
    </config-option>
    <text-box-config-option>
      <template name="config-option">
        <child id="value-container">
          <flow-layout direction="horizontal">
            <children>
              <config-text-box id="value-box">
                <text>{{config-option-value}}</text>
                <show-background>false</show-background>
                <valid-color>#FFE6E7E9</valid-color>
                <invalid-color>#FFE5484D</invalid-color>
                <sizing>
                  <horizontal method="fill">100</horizontal>
                  <vertical method="fixed">10</vertical>
                </sizing>
              </config-text-box>
            </children>
            <vertical-alignment>center</vertical-alignment>
            <padding>
              <horizontal>6</horizontal>
              <vertical>5</vertical>
            </padding>
            <surface>
              <flat>#FF111317</flat>
              <outline>#FF22262D</outline>
            </surface>
          </flow-layout>
        </child>
      </template>
    </text-box-config-option>
    <boolean-toggle-config-option>
      <template name="config-option">
        <child id="value-container">
          <monumentum-toggle-button id="toggle-button">
            <text-shadow>false</text-shadow>
          </monumentum-toggle-button>
        </child>
      </template>
    </boolean-toggle-config-option>
    <enum-config-option>
      <template name="config-option">
        <child id="value-container">
          <config-enum-button id="enum-button">
            <renderer>
              <flat color="#FF181B20" hovered-color="#FF22262D" disabled-color="#FF121417"/>
            </renderer>
            <text-shadow>false</text-shadow>
          </config-enum-button>
        </child>
      </template>
    </enum-config-option>
    <range-config-option>
      <template name="config-option-base">
        <child id="controls">
          <flow-layout direction="horizontal" id="controls-flow">
            <children>
              <button id="toggle-button">
                <text>✎</text>
                <tooltip-text translate="true">text.owo.config.button.range.edit_as_text</tooltip-text>
                <renderer>
                  <flat color="#00000000" hovered-color="#554F8CFF" disabled-color="#00000000"/>
                </renderer>
                <sizing>
                  <vertical method="fixed">16</vertical>
                </sizing>
              </button>
              <flow-layout direction="horizontal" id="slider-controls">
                <children>
                  <config-slider id="value-slider">
                    <margins>
                      <all>1</all>
                    </margins>
                    <sizing>
                      <horizontal method="fixed">120</horizontal>
                    </sizing>
                  </config-slider>
                  <button id="reset-button">
                    <text>⇄</text>
                    <renderer>
                      <flat color="#FF181B20" hovered-color="#FF22262D" disabled-color="#FF121417"/>
                    </renderer>
                    <margins>
                      <horizontal>5</horizontal>
                    </margins>
                  </button>
                </children>
                <vertical-alignment>center</vertical-alignment>
              </flow-layout>
            </children>
            <gap>2</gap>
          </flow-layout>
        </child>
      </template>
    </range-config-option>
    <color-picker-panel>
      <flow-layout direction="vertical">
        <children>
          <label>
            <text translate="true">monumentum.config.color.title</text>
            <color>#FFE6E7E9</color>
            <shadow>false</shadow>
          </label>
          <color-picker id="color-picker">
            <show-alpha>{{with-alpha}}</show-alpha>
            <selected-color>{{color}}</selected-color>
            <sizing>
              <horizontal method="fixed">160</horizontal>
              <vertical method="fixed">100</vertical>
            </sizing>
          </color-picker>
          <flow-layout direction="horizontal">
            <children>
              <box>
                <fill>true</fill>
                <color>{{color}}</color>
                <sizing>
                  <horizontal method="fixed">80</horizontal>
                  <vertical method="fixed">15</vertical>
                </sizing>
              </box>
              <box id="current-color">
                <fill>true</fill>
                <color>{{color}}</color>
                <sizing>
                  <horizontal method="fixed">80</horizontal>
                  <vertical method="fixed">15</vertical>
                </sizing>
              </box>
            </children>
          </flow-layout>
          <flow-layout direction="horizontal">
            <children>
              <button id="cancel-button">
                <text translate="true">monumentum.config.color.cancel</text>
                <renderer>
                  <flat color="#FF181B20" hovered-color="#FF22262D" disabled-color="#FF121417"/>
                </renderer>
                <sizing>
                  <horizontal method="fixed">50</horizontal>
                  <vertical method="fixed">14</vertical>
                </sizing>
              </button>
              <button id="confirm-button">
                <text translate="true">monumentum.config.color.confirm</text>
                <renderer>
                  <flat color="#FF2F6FE0" hovered-color="#FF4A87F5" disabled-color="#FF1C2230"/>
                </renderer>
                <sizing>
                  <horizontal method="fixed">50</horizontal>
                  <vertical method="fixed">14</vertical>
                </sizing>
              </button>
            </children>
            <gap>10</gap>
          </flow-layout>
        </children>
        <horizontal-alignment>center</horizontal-alignment>
        <gap>5</gap>
        <padding>
          <all>5</all>
        </padding>
        <surface>
          <flat>#FF111317</flat>
          <outline>#FF1A1D22</outline>
        </surface>
      </flow-layout>
    </color-picker-panel>
    <boolean-toggle-config-option>
      <template name="config-option">
        <child id="value-container">
          <flow-layout direction="horizontal">
            <children>
              <monumentum-toggle-button id="toggle-button"/>
            </children>
            <horizontal-alignment>right</horizontal-alignment>
            <vertical-alignment>center</vertical-alignment>
          </flow-layout>
        </child>
      </template>
    </boolean-toggle-config-option>
  </templates>
</owo-ui>